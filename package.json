{
  "name": "rune",
  "private": true,
  "version": "1.0.0-rc.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:e2e:workbench": "wdio run wdio.conf.mjs --spec e2e/workbench.smoke.mjs && wdio run wdio.conf.mjs --spec e2e/workbench.restore.smoke.mjs",
    "test:e2e:workbench:linux": "wdio run wdio.linux.conf.mjs --spec e2e/workbench.smoke.mjs && node tools/verify-workbench-recovery-fixture.mjs && wdio run wdio.linux.conf.mjs --spec e2e/workbench.restore.smoke.mjs",
    "gen:brand": "node tools/gen-brand-assets.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/michroma": "^5.2.8",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@vscode/markdown-it-katex": "^1.1.2",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "markdown-it": "^14.2.0",
    "mermaid": "^11.16.1",
    "pretendard": "^1.3.9"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/cli": "^2",
    "@types/markdown-it": "^14.1.2",
    "@wdio/cli": "^9.30.1",
    "@wdio/jasmine-framework": "^9.30.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "@wdio/tauri-plugin": "^1.3.0",
    "@wdio/tauri-service": "^1.3.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
